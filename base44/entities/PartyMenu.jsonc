{
  "name": "PartyMenu",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Menu Title"
    },
    "title_bn": {
      "type": "string",
      "title": "Menu Title (Bangla)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Menu Items"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "price_per_person": {
      "type": "number",
      "title": "Price per Person (BDT)"
    },
    "min_guests": {
      "type": "number",
      "title": "Minimum Guests",
      "default": 20
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "title",
    "items"
  ]
}